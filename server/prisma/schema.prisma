generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  ownedWorkspaces  Workspace[]         @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  ownedDocuments   Document[]          @relation("DocumentOwner")
  permissions      DocumentPermission[]
}

// A workspace is a container documents belong to. Membership determines
// who can create/see documents scoped to it (see WorkspaceMember).
model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  members   WorkspaceMember[]
  documents Document[]
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
}

enum DocumentRole {
  OWNER
  EDITOR
  VIEWER
}

model Document {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User     @relation("DocumentOwner", fields: [ownerId], references: [id])
  title       String
  content     String   @default("")
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions DocumentPermission[]
  snapshots   DocumentSnapshot[]
}

model DocumentPermission {
  id         String       @id @default(uuid())
  documentId String
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  role       DocumentRole
  createdAt  DateTime     @default(now())

  @@unique([documentId, userId])
}

model DocumentSnapshot {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  version    Int
  createdAt  DateTime @default(now())
}
